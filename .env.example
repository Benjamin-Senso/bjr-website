# Path to the SQLite database file (relative to the project root in dev).
# In Docker this is set to file:/app/data/bjr.db so it lands on the volume.
DATABASE_URI=file:./bjr.db

# Used to sign/secure Payload cookies & tokens — set to a long random string.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# The public origin of the site, with protocol and no trailing slash.
# Makes OG/Twitter image URLs absolute (social scrapers require this) and is
# used as the base for sitemap.xml and robots.txt.
# Dev: http://localhost:3000   Prod: https://your-domain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# beehiiv (optional). Both are required together — with either missing, the
# /writing page stays hidden from the nav and renders an empty state.
# API key: beehiiv dashboard, Settings, Integrations, API.
# Publication ID: same page, starts with "pub_".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Cloudflare R2 for uploaded media (optional). All four are required together;
# with any missing, uploads fall back to local disk / the Docker volume.
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
# Keys come from Cloudflare dashboard, R2, Manage API Tokens.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public base URL for serving files, e.g. https://media.your-domain.com (an R2
# custom domain) or the bucket's r2.dev URL. Without it files are proxied
# through the Next server, which works but gives up Cloudflare's CDN.
R2_PUBLIC_URL=

# Where uploaded media is written when R2 is NOT configured.
# Only set in Docker; dev uses the default.
# MEDIA_DIR=/app/data/media
